    "#range\n",
    "start=int(input(\"Enter starting number:\"))\n",
    "end=int(input(\"Enter ending number:\"))\n",
    "numbers=range(start,end+1,2)\n",
    "print(\"Even numbers:\",*numbers)\n",
    "print(\"Sum:\",sum(numbers))"
